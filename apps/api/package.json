{
  "name": "@gengis-khan/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-concurrency=1 src/**/*.test.ts",
    "test:unit": "tsx --test --test-concurrency=1 src/**/*.unit.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 src/modules/**/*.test.ts",
    "test:system": "tsx --test --test-concurrency=1 src/system/**/*.test.ts",
    "test:acceptance": "tsx --test --test-concurrency=1 src/acceptance/**/*.test.ts",
    "test:quality": "tsx --test --test-concurrency=1 src/quality/**/*.test.ts",
    "test:coverage": "node --experimental-test-coverage --import=tsx --test --test-concurrency=1 src/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@gengis-khan/contracts": "workspace:*",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.2",
    "fastify": "^4.29.0",
    "fastify-plugin": "^5.0.1",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.0.5",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.17.0",
    "pino": "^9.7.0",
    "zod": "^3.24.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.17.3",
    "prisma": "^5.22.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
